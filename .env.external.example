# External deployment example. Copy to the external host's secret manager; never commit real values.
NODE_ENV=production
PORT=3000
CANONICAL_ORIGIN=https://invite.avocadoss.co.kr

# MySQL-compatible database
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/chaewon_invitation

# Keep new, strong values only in the external host's secret manager.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
ADMIN_DASHBOARD_PASSWORD=REPLACE_WITH_PRIMARY_ADMIN_PASSWORD
SECONDARY_ADMIN_DASHBOARD_PASSWORD=REPLACE_WITH_SECONDARY_ADMIN_PASSWORD

# S3/R2-compatible object storage. A public custom media hostname is recommended.
EXTERNAL_S3_BUCKET=chaewon-invitation-media
EXTERNAL_S3_PUBLIC_BASE_URL=https://media.invite.avocadoss.co.kr
EXTERNAL_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
EXTERNAL_S3_REGION=auto
EXTERNAL_S3_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY_ID
EXTERNAL_S3_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_ACCESS_KEY

# Set true for providers that require path-style bucket addressing.
EXTERNAL_S3_FORCE_PATH_STYLE=false
